{
    "name": "meta-server",
    "version": "1.0.0",
    "description": "Simplified metaverse with static objects and client-side physics",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "start:prod": "cross-env NODE_ENV=production node server.js",
        "dev": "concurrently \"nodemon server.js\" \"wait-on http://localhost:3000 --timeout 30000 && vite\"",
        "dev:vcdebug": "concurrently \"cross-env VC_DEBUG_STATS=1 nodemon server.js\" \"wait-on http://localhost:3000 --timeout 30000 && vite\"",
        "build": "node scripts/ensure-build-deps.mjs && vite build",
        "preview": "vite preview",
        "test:nfc-spawn": "node --test addons/nfc-spawn/test/*.test.js",
        "test:meta-bench-r1": "node --test addons/meta-bench-r1/test/*.test.js",
        "test:time-machine": "node --test addons/time-machine/test/*.test.js",
        "bench:install-aiortc": "node scripts/install-bench-aiortc.mjs",
        "bench:install-runner-deps": "npm install --no-fund --no-audit --ignore-scripts",
        "test:webxr-vr": "node --test addons/webxr-vr/test/*.test.js",
        "test:spawn-pending": "node --test test/spawn-pending-storage.test.js",
        "test:admin-security": "node --test test/admin-security.test.js",
        "test:captions": "node --test test/speech-captions.test.js test/captions-log.test.js test/caption-segmenter.test.js test/caption-display-format.test.js test/caption-translation.test.js test/ui-locale.test.js"
    },
    "keywords": [
        "metaverse",
        "three.js",
        "socket.io",
        "three-mesh-bvh",
        "multiplayer"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.1038.0",
        "@aws-sdk/client-s3": "^3.1038.0",
        "@aws-sdk/cloudfront-signer": "^3.1036.0",
        "@gltf-transform/core": "^4.3.0",
        "@gltf-transform/extensions": "^4.3.0",
        "@gltf-transform/functions": "^4.3.0",
        "@google-cloud/speech": "^8.0.1",
        "@google-cloud/translate": "^10.0.1",
        "@google/generative-ai": "^0.24.1",
        "@web-ar-studio/webar-engine-sdk": "^1.0.24",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.6.2",
        "bootstrap-icons": "^1.13.1",
        "cheerio": "^1.2.0",
        "cookie": "^1.1.1",
        "cookie-parser": "^1.4.7",
        "cross-env": "^7.0.3",
        "dotenv": "^17.2.3",
        "draco3dgltf": "^1.5.7",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.2",
        "fake-mediastreamtrack": "^2.2.1",
        "fflate": "^0.8.2",
        "ffmpeg-static": "^5.3.0",
        "helmet": "^8.1.0",
        "mediasoup": "^3.19.14",
        "mediasoup-client": "^3.18.3",
        "multer": "^2.0.2",
        "nipplejs": "^0.10.2",
        "pdfjs-dist": "^4.8.69",
        "semver": "^7.7.4",
        "sharp": "^0.35.3",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.8.1",
        "three": "^0.160.0",
        "three-mesh-bvh": "^0.9.3",
        "three-mesh-ui": "^6.5.4"
    },
    "optionalDependencies": {
        "mediasoup-client-aiortc": "^3.16.1"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "nodemon": "^3.1.11",
        "vite": "^7.2.6",
        "wait-on": "^8.0.1"
    }
}
