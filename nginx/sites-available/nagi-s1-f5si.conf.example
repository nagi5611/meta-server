# RETIRED (2026-11): nagi-s1.f5.si hub は廃止。nginx/hub-admin-line/README.md 参照。
# 以下は履歴用テンプレのみ。本番にデプロイしないこと。
#
# 管理・非常用ライン: http://nagi-s1.f5.si/ → hub-server.service（127.0.0.1:3000）
# 役割・ディレクトリ・hub.env: nginx/hub-admin-line/README.md
# metaverse-proxy.conf の nagi-s1 server ブロックと server_name を二重定義しないこと
#
# hub.env に HOST_MONITOR_UNITS を設定し、hub-server.service で /home/nagi/meta-server を起動する
#
# sudo mkdir -p /var/www/metaverse-nginx-errors
# sudo cp nginx/html/metaverse-proxy-error.html /var/www/metaverse-nginx-errors/
# sudo cp nginx/snippets/metaverse-proxy-error-pages.conf.example /etc/nginx/snippets/metaverse-proxy-error-pages.conf
# sudo cp nginx/sites-available/nagi-s1-f5si.conf.example /etc/nginx/sites-available/nagi-s1-f5si.conf
# sudo nano /etc/nginx/sites-available/nagi-s1-f5si.conf   # proxy_pass のポートを環境に合わせる
# sudo ln -sf /etc/nginx/sites-available/nagi-s1-f5si.conf /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name nagi-s1.f5.si;

    # 管理画面の 3D モデル等（multipart）用。未指定だと nginx 既定 1m で 413 になる
    client_max_body_size 500m;

    include /etc/nginx/snippets/metaverse-proxy-error-pages.conf;

    location = / {
        return 302 /host-monitor/;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
