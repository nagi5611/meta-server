# meta-server 環境変数サンプル
# クローン後: cp .env.example .env してから編集すること

# 本番では NODE_ENV=production とし、下記 SOCKET_* を必ず設定すること（未設定だと起動時に失敗する）
# NODE_ENV=production

# 待ち受け
PORT=3000
HOST=0.0.0.0

# リバースプロキシ（nginx / Caddy 等で TLS 終端する場合）
# 手順・設定例: nginx/README.md
# 1 / true / yes / on で有効。有効時は Node は HTTP のみ（SSL_CERT_PATH は無視）
# USE_REVERSE_PROXY=1
# プロキシ段数など: 未設定なら trust proxy = 1。無効にするなら TRUST_PROXY=0
# TRUST_PROXY=1
#
# 平文 HTTP を受け付けない（1/true/yes/on）。Express の req.secure が false の要求を 403。
# リバースプロキシ時は TLS 終端＋X-Forwarded-Proto を付与し、上記 TRUST_PROXY を有効にすること。
# Node 直 HTTPS のときは SSL_CERT_PATH / SSL_KEY_PATH が必要。プロキシも Node 直 TLS も無い構成では起動失敗。
# REQUIRE_SECURE_HTTP=1
#
# ドメインごとのバックエンドポート（改行またはカンマ区切り、host=port）
# 例（1行）:
# PROXY_DOMAIN_PORT_MAP=meta.mmh-virtual.jp=3000,metair.mmh-virtual.jp=3001
# 例（複数行はダブルクォートで囲む）:
# PROXY_DOMAIN_PORT_MAP="meta.mmh-virtual.jp=3000
# metair.mmh-virtual.jp=3001"
#
# このプロセスがどのドメイン向けか（設定すると PORT はマップから自動、PORT と矛盾すると起動失敗）
# PROXY_SERVICE_DOMAIN=meta.mmh-virtual.jp

# WebRTC 外部接続用: このサーバーの公衆 IP またはドメイン（空なら LAN のみ）
MEDIASOUP_ANNOUNCED_IP=
# 同一 LAN 内からも WebRTC させる場合（公衆 IP と併用）: サーバーのプライベート IPv4（例: 192.168.0.74）
# MEDIASOUP_ANNOUNCED_LAN_IP=

# Voice Chat 用 mediasoup UDP ポート範囲
VC_RTC_MIN_PORT=10000
VC_RTC_MAX_PORT=11000

# PDF ビューワー VC 用
PDF_VC_RTC_MIN_PORT=20000
PDF_VC_RTC_MAX_PORT=21000

# ビデオ VC 用
VIDEO_VC_RTC_MIN_PORT=30000
VIDEO_VC_RTC_MAX_PORT=31000
VIDEO_VC_MAX_PRODUCERS_PER_ROOM=10

# 音声・PDF・ビデオ VC それぞれの mediasoup Router 同時保持数の上限（未設定時は 128）
# VC_MAX_ROUTERS=128

# Cloudflare TURN（任意。未設定なら STUN のみ）
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_KEY_ID=

# 管理画面の認証（ADMIN_PASSWORD は必ず変更すること）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# admin-reboot アドオン: 設定したときのみ Web の「サーバー再起動」に PIN 入力を要求する（ADDON_<アドオンID>_ は lib/plugin-config.js 参照）
# ADDON_ADMIN_REBOOT_PIN=

# avator-scalable-animations: 追加モーションのキー再生。管理画面「アドオン」→ 設定では「キー＝定義名」「値＝割り当てキー」（DB に保存。再起動で反映）。環境変数は ADDON_AVATOR_SCALABLE_ANIMATIONS_<名前>=割り当てキー（名前は ASCII のみ推奨）
# ADDON_AVATOR_SCALABLE_ANIMATIONS_BINDINGS=[{"name":"スクワット","key":"9","id":"squat"}]
# ADDON_AVATOR_SCALABLE_ANIMATIONS_SQUAT=9

# Socket.io 用ロールトークン署名（生徒・教師の HTTP ログイン成功時に発行）。本番では強い乱数を必ず設定すること
# 未設定時は起動ごとにランダム生成され、再起動で既存トークンはすべて無効になる
# SOCKET_AUTH_SECRET=

# 本番必須: ブラウザから Socket.io するオリジンをカンマまたは改行区切りで列挙（例: https://meta.example.com）
# SOCKET_CORS_ORIGINS=https://meta.example.com

# 本番で Origin ヘッダが無いクライアントを許可する場合のみ 1（非ブラウザ・特殊プロキシ用。通常は不要）
# SOCKET_CORS_ALLOW_MISSING_ORIGIN=1

# ゲスト接続を拒否する: 0 / false / off / no（未設定のときはゲスト接続を許可。本番で締めるなら 0）
# SOCKET_ALLOW_GUEST=0

# チャット・一般ログイン時のユーザー名 AI モデレーション（Gemini API）。GEMINI_API_KEY 未設定時はチャット送信およびゲストの表示名設定ができない（拒否）
# モデル名は https://ai.google.dev/gemini-api/docs/models 等の公式一覧で利用可否を確認すること
# GEMINI_API_KEY=
# 既定（ENV 未設定時）: gemini-3.1-flash-lite-preview。2026/04 時点の Google ブログ等では 2.5 Flash-Lite より低遅延とされる。プレビュー制限あり。安定版は GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODERATION_TIMEOUT_MS=15000
#
# NG ワード一覧の JSON（任意。未設定時は config/chat-ng-words.json）。管理画面「セキュリティ」→「チャット」でも編集。保存内容はモデレーション時に Gemini のシステムプロンプトへ結合される
# CHAT_NG_WORDS_PATH=

# 公開ユーザー登録 API（本番では既定で無効。1/true/yes/on で有効）
# ALLOW_PUBLIC_REGISTRATION=0

# 本番で secure Cookie を付けない場合のみ 0（通常は付与される）
# COOKIE_SECURE=1

# ホスト監視（任意）: systemd ユニットの状態表示と Web からの起動。未設定なら無効
# 手順・nginx 例・sudoers: nginx/README.md の「ホスト監視ダッシュボード」
# HOST_MONITOR_UNITS=meta-server.service,nginx.service

# 太鼓・譜面・譜面BGM・admin 譜面編集（計算資源を抑えたい場合に無効化）。未設定または 1/true/yes/on で有効。0/false/off/no で無効（次回サーバー起動から反映）
# ENABLE_CHART_FEATURES=0

# 帯域制限（Mbps）
BANDWIDTH_LIMIT_MBPS=100

# メタバースクライアント: ワールド読込の計画（署名・HEAD・プレハブ各パーツの見積）と実読込の同時実行上限。1〜128、既定 24（/api/client-config で配信）
# METAVERSE_PLAN_LOAD_CONCURRENCY=24

# 管理画面からの 3D モデル一式アップロード（/admin/upload）の最大サイズ（MiB）。未設定時は 500
# リバースプロキシ利用時は client_max_body_size 等も同程度以上にすること
# MODEL_UPLOAD_MAX_MB=500

# Prefab ZIP（/admin/upload-prefab-zip）内の最大エントリ数（解凍後のファイル本数の上限）。未設定時は 500
# 極端に大きい値は起動時にハード上限へクランプされる（lib/prefab-bundle-upload.js 参照）
# PREFAB_ZIP_MAX_ENTRIES=2000

# Node 直で HTTPS する場合（USE_REVERSE_PROXY 無効時のみ有効）
# SSL_CERT_PATH=certs/fullchain.pem
# SSL_KEY_PATH=certs/privkey.pem
# PORT=443
# PORT_HTTP_REDIRECT=80

# --- 3D モデル: S3 + CloudFront（任意・本番のみ）
# 開発（NODE_ENV≠production）では無効。NODE_ENV=production かつ USE_S3_MODELS=1 のとき有効。
# 有効時: 管理画面のアップロードはローカル models/ 確定後に S3 へ Put。ファイル削除時は S3 からも Delete。起動時はマニフェスト同期。
# S3 への Put/Delete/同期には AWS_REGION + バケット名があれば動く（CloudFront 署名キー未設定でもアップロードは可能。署名 URL は別途 CLOUDFRONT_* が必要）。
# クライアントは CloudFront 用の署名 URL を取得してから GET（失敗時は同一オリジンの /models にフォールバック。要メタバースログイン Cookie または管理 Basic）。
# 詳細ドキュメント: docs/setup-s3-cloudfront-models.md
#
# 【必須（USE_S3_MODELS=1 のとき）】本番で揃える項目
# NODE_ENV=production
# USE_S3_MODELS=1
#
# AWS_REGION … S3 バケットのリージョン（例: ap-northeast-1）
# AWS_REGION=
#
# META_MODELS_S3_BUCKET … モデルオブジェクトを置くプライベート S3 バケット名。
# 別名: AWS_S3_BUCKET（どちらかがあれば読み取る。両方ある場合は META_MODELS_S3_BUCKET を優先）
# META_MODELS_S3_BUCKET=
#
# メタバースサーバーが S3 にアクセスする資格（実装は @aws-sdk のデフォルトチェーン）
# - EC2/ECS/Lambda など: IAM ロールに s3:PutObject / s3:GetObject / s3:DeleteObject / s3:ListBucket を付与すればよく、下のキーは不要なことが多い。
# - VPS 等キー認証の場合:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# META_CDN_PUBLIC_BASE または CLOUDFRONT_BASE_URL … ブラウザに保存する・参照に使う CDN のベース URL（https:// で始める）。
# 例: https://dxxxxxxxxxxxx.cloudfront.net  またはプレフィックス付き https://dxxxxxxxxxxxx.cloudfront.net/prod
# 末尾スラッシュは有っても無くてもよい（コード側で正規化）。マニフェスト・worlds.json の絶対 URL と一致させる。
# META_CDN_PUBLIC_BASE=
#
# META_MODELS_S3_PREFIX … （任意）S3 オブジェクトキーの先頭。末尾スラッシュは不要。未設定時は models。
# 例: prod/models → キーは prod/models/フォルダ配下。META_CDN_PUBLIC_BASE のパスと整合させること。
# META_MODELS_S3_PREFIX=models
#
# META_ENV_S3_PREFIX … （任意）IBL 用 default.hdr を置く S3 キー先頭。avatars と同様にモデルプレフィックスの「兄弟」パスになる想定。未設定時は env（キー例: env/default.hdr）。nested 構成なら META_MODELS_S3_PREFIX に合わせて例: prod/env
# META_ENV_S3_PREFIX=env
#
# META_MODELS_S3_UPLOAD_CONCURRENCY … （任意）Prefab ZIP 等の複数ファイルを S3 に送るときの同時 Put 本数。起動時 S3 同期の各バッチでも同じ既定を使う。未設定時は 16。1〜128 にクランプ。
# META_MODELS_S3_UPLOAD_CONCURRENCY=16
#
# 起動時ローカル↔S3 の差分同期は models/_meta/s3-sync-manifest.json（S3 上も同キー体系）を使う。追加の .env は不要。リモートにマニフェストが無い・壊れている初回のみ従来の Head/MD5 と List（孤児削除）が多く走る。IAM に ListBucket が無いと孤児削除だけスキップされ、マニフェストは書き込まれる（docs/setup-s3-cloudfront-models.md の IAM 例参照）。
#
# CloudFront 署名用（GET 用の短命 URL を /api/metaverse/sign-asset-urls で発行するために必要）
# CLOUDFRONT_KEY_PAIR_ID … コンソールの「キーペア ID」（公開側の識別子）
# CLOUDFRONT_PRIVATE_KEY … PEM の本文（改行はそのままか \n で1行にしてもよい）
# またはファイルパスだけ:
# CLOUDFRONT_PRIVATE_KEY_PATH=/path/to/cloudfront-private-key.pem
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_PRIVATE_KEY_PATH=
#
# CLOUDFRONT_SIGN_EXPIRES_SECONDS … （任意）署名 URL の有効秒数。既定 900（15 分）。60〜86400 の範囲が目安。
# CLOUDFRONT_SIGN_EXPIRES_SECONDS=900
#
# 管理画面「ワールド編集」の setting.js を動的 import するとき、静的ホストが誤った内容を返す場合のフォールバック先（Node が配信する URL のオリジン、例 https://api.example.com）。
# 未設定時はブラウザのページオリジンのみ試行する。異なるオリジンから import する場合は MODULE_SCRIPT_CORS_ORIGIN も併用すること。
# MODULE_SCRIPT_ORIGIN=
# MODULE_SCRIPT_CORS_ORIGIN は * または 1 件の Origin（静的 admin と API のホストが別のとき）
# MODULE_SCRIPT_CORS_ORIGIN=*

# --- データ配置（いずれか）
# 推奨: リポジトリ直下など1か所を指定すると models / pdfs / data / env 等がその配下に揃う
# META_SRC_DIRECTORY=/home/you/meta-server
# （上記時、IBL 用 HDR は <META_SRC_DIRECTORY>/env 。admin から default.hdr をアップロード可）
#
# または META_MODELS_DIR / META_PDFS_DIR … を個別指定する場合:
# IBL 用は META_ENV_DIR で上書き可能。未設定なら META_MODELS_DIR の親ディレクトリ直下の env を使う
# META_ENV_DIR=/var/lib/meta/env

